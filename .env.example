# =============================================================================
# Intelligence System — configuración
# Copiá este archivo a .env (run.sh / run.ps1 lo hacen automáticamente).
# Nunca subas .env al repositorio.
# =============================================================================

# ── LLM ──────────────────────────────────────────────────────────────────────
# anthropic | gemini | openai | ollama
# Combinaciones sin Ollama: ver "Proveedores" en el README
#   Claude + embeddings Gemini → LLM_PROVIDER=anthropic, EMBEDDING_PROVIDER=gemini
#   100% Gemini                → LLM_PROVIDER=gemini,    EMBEDDING_PROVIDER=gemini
LLM_PROVIDER=ollama
LLM_TEMPERATURE=0
# Timeout por llamada al LLM; vacío = 600 s con Ollama, 120 s con APIs cloud
LLM_TIMEOUT_SECONDS=

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Google Gemini (https://aistudio.google.com/apikey)
# También se acepta GEMINI_API_KEY (nombre usado en la documentación de Google)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Google recomienda 1.0 para los modelos Gemini 3.x
GEMINI_TEMPERATURE=1.0

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama (local, sin costo). Desde Docker se accede al Ollama del host con
# host.docker.internal; docker-compose ya lo configura.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Ventana de contexto (evita que Ollama trunque prompts largos)
OLLAMA_NUM_CTX=8192

# ── Embeddings ───────────────────────────────────────────────────────────────
# ollama | gemini | openai   (Anthropic no ofrece API de embeddings)
# Al cambiar de modelo, la API detecta la diferencia y recrea el índice sola.
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Dimensión de salida de Gemini (128–3072); vacío = nativa del modelo
GEMINI_EMBEDDING_DIMENSIONS=768

# ── Vector store ─────────────────────────────────────────────────────────────
# redis (local, por defecto) | pinecone (cloud) | memory (tests)
VECTOR_STORE=redis
# Réplica de failover opcional (vacío = sin réplica). Ej.: VECTOR_STORE=pinecone + VECTOR_STORE_FALLBACK=redis
VECTOR_STORE_FALLBACK=
# Si el principal no responde en este tiempo se consulta la réplica (y si ambos fallan, BM25)
VECTOR_SEARCH_TIMEOUT_SECONDS=5
REDIS_INDEX_NAME=intelligence-kb

PINECONE_API_KEY=
PINECONE_INDEX_NAME=intelligence-kb
PINECONE_NAMESPACE=documents
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ── RAG ──────────────────────────────────────────────────────────────────────
CHUNK_SIZE=600
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=5
BM25_WEIGHT=0.4
VECTOR_WEIGHT=0.6
RRF_K=60
# Ingesta automática al arrancar si el índice está vacío
AUTO_INGEST=true

# ── Herramientas de investigación ────────────────────────────────────────────
# Opcional: sin clave, el Research Agent usa solo Wikipedia
TAVILY_API_KEY=
WIKIPEDIA_LANG=es
# Wikimedia exige un User-Agent con datos de contacto (https://w.wiki/4wJS)
WIKIPEDIA_USER_AGENT="IntelligenceSystem/1.0 (https://github.com/ctorres014; educational project)"

# ── Redis (checkpointer de LangGraph + tareas + vector store) ───────────────
# docker-compose lo sobreescribe con redis://redis:6379
REDIS_URL=redis://localhost:6380
JOB_TTL_SECONDS=86400
# Vacío = los checkpoints no expiran
CHECKPOINT_TTL_MINUTES=

# ── Orquestación ─────────────────────────────────────────────────────────────
MAX_ITERATIONS=8
HISTORY_WINDOW=6
# El primer paso de cada turno consulta siempre la base de conocimiento
RAG_FIRST=true

# ── Observabilidad ───────────────────────────────────────────────────────────
PHOENIX_ENABLED=true
# docker-compose lo sobreescribe con http://phoenix:6006
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT_NAME=intelligence-system
LOG_LEVEL=INFO

# Alternativa: LangSmith (poner PHOENIX_ENABLED=false)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=intelligence-system

# ── Puertos expuestos en el host (docker-compose) ────────────────────────────
API_PORT=8000
PHOENIX_PORT=6006
REDIS_HOST_PORT=6380
